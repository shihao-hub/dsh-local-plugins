{
  "name": "@local/agy-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only Antigravity (agy) research delegation bridge for DeepSeek Harness: an MCP stdio server wrapping `agy -p ... --sandbox --mode plan --output-format json`.",
  "exports": {
    ".": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/launch.mjs",
    "bin/agy-run.mjs",
    "server/agy_bridge_server.py",
    "server/win_job.py",
    "cordis.patch.yml",
    "locale/*.json",
    "cordis.patch.resolved.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}

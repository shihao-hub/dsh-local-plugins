{
  "name": "@local/plugin-source-tabs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Splits the installed plugins list into Local and Downloaded tabs, opening on Local by default.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "self-test.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}

{
  "name": "@local/rider-theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Registers the JetBrains Rider Dark palette (ported from the Zed jetbrains-rider theme) as a switchable DSH theme and adds an appearance-row switch for it.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}

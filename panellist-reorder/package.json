{
  "name": "@local/panellist-reorder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Drag the sidebar panel rows (模组/技能/任务/…) to sort them yourself; the order is stored per browser and re-applied after reloads or plugin changes.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
